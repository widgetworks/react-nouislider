{
  "name": "@wiwo/nouislider-react",
  "private": false,
  "version": "3.4.2-wiwo.2",
  "description": "React component wrapping leongersen/noUiSlider",
  "type": "module",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "clean": "rm -r dist",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coveralls": "vitest run --coverage && cat ./coverage/lcov.info | coveralls",
    "test:watch": "vitest"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mmarkelov/react-nouislider"
  },
  "keywords": [
    "react",
    "nouislider",
    "slider",
    "component",
    "reactjs",
    "range",
    "slider"
  ],
  "author": "Maksim Markelov <mapkeji26@gmail.com>",
  "homepage": "https://github.com/mmarkelov/react-nouislider",
  "license": "MIT",
  "dependencies": {
    "nouislider": ">= 11.x"
  },
  "peerDependencies": {
    "nouislider": ">= 11.x",
    "react": ">= 16.8.x"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
